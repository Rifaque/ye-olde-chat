# Absolute http(s) URL used for canonical and Open Graph links. Required for
# non-Vercel production deployments. It takes priority over Vercel's system URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Global copy stats (optional) -------------------------------------------
# Server-only Upstash Redis REST credentials. Never prefix these with
# NEXT_PUBLIC_. Without them the site works normally and Popular shows that
# tallies are unavailable. Vercel's Upstash integration may instead provide
# KV_REST_API_URL and KV_REST_API_TOKEN, which are read as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional secret used to hash client IPs for rate limiting. Defaults to the
# Redis token. Changing it simply starts fresh one-minute rate-limit windows.
STATS_RATE_LIMIT_SECRET=

# Local development only: set to "memory" to try Popular without Redis. Counts
# live in the dev server process and vanish on restart. Ignored in production.
STATS_STORE=
